# Database
DATABASE_URL=
DIRECT_URL=

# Security and browser access
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://your-frontend.vercel.app

# First admin account (set once before the first deploy)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer OTP email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SW Hub

# Google Authentication (OAuth 2.0 Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Optional enquiry recipient
VENDOR_ENQUIRY_RECEIVER_EMAIL=

# Shiprocket Courier & Delivery Integration
SHIPROCKET_ENABLED=false
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=

