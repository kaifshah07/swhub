# Database
DATABASE_URL=
DIRECT_URL=

# Security and browser access
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://your-frontend.vercel.app

# First admin account (set once before the first deploy)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Customer OTP email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SW Hub

# Optional enquiry recipient
VENDOR_ENQUIRY_RECEIVER_EMAIL=
